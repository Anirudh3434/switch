# Copy to .env and fill in. Never commit .env.
#
# NODE_ENV=production makes the server fail closed: it will refuse to boot
# unless every secret below is present and long enough. There are no fallback
# secrets in production.

# Required in every environment.
# Local: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/switch
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=switch

# Environment: development | production | test
NODE_ENV=development

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (min lengths enforced)
# ---------------------------------------------------------------------------
# Signs access tokens. >= 32 chars. Rotating it invalidates all access tokens.
# Generate: openssl rand -base64 48
TOKEN_SECRET=

# Peppers refresh-token hashes. >= 16 chars.
REFRESH_PEPPER=

# Secret used to make dummy salts and OTP hashes unpredictable. >= 16 chars.
DUMMY_SALT_SECRET=

# Comma-separated CORS allowlist. Required in production.
# Your extension origins go here, for example:
#   chrome-extension://abcdefghijklmnop
#   extension://<edge-extension-id>
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Admin console
# ---------------------------------------------------------------------------
# Comma-separated emails allowed to use /v1/admin. These must be normal,
# verified Switch accounts. There is no shared admin password.
# LEAVE EMPTY TO DISABLE THE ADMIN API ENTIRELY (it returns 403).
# Do not use this for storage quotas; everyone is capped by MAX_USER_BYTES.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Tokens and limits
# ---------------------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Per-account encrypted-blob budget (bytes). Default 50 MB.
MAX_USER_BYTES=52428800

# Number of trusted reverse-proxy hops in front of the API. Set this to match
# your load balancer. A wrong value lets clients spoof X-Forwarded-For and
# evade IP rate limits.
TRUST_PROXY_HOPS=1

# PORT=8080

# ---------------------------------------------------------------------------
# Email OTP delivery
# ---------------------------------------------------------------------------
# Generate a 16-character Google App Password at:
# https://myaccount.google.com/apppasswords
# If SMTP_USER/SMTP_PASS are empty in development, the server logs OTPs to the
# console instead of sending mail. Production always requires real SMTP: there
# is no devOtp in API responses.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Switch <no-reply@your-domain.example>"
OTP_TTL_SECONDS=600
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Development / test only
# ---------------------------------------------------------------------------
# Production always requires a verified email before account creation. This
# escape hatch is ignored when NODE_ENV=production.
ALLOW_UNVERIFIED_REGISTRATION=false

# Set to 1 only when intentionally running DB-backed tests without MongoDB.
# Otherwise those tests fail loudly.
ALLOW_DB_TEST_SKIP=0
